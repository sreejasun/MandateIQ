# MandateIQ configuration
# Copy this file to .env (in the repository root) and fill in your values.
# Never commit .env.

# ------------------------------------------------------------
# Default model provider for new reviews: bedrock | groq | mock
# The web interface lets you pick any configured provider per review.
# ------------------------------------------------------------
LLM_PROVIDER=mock

# ------------------------------------------------------------
# Amazon Bedrock (main provider)
# Uses the standard AWS credential chain: AWS_PROFILE, or
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (/ AWS_SESSION_TOKEN).
# ------------------------------------------------------------
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# AWS_PROFILE=default

# ------------------------------------------------------------
# Groq (alternative when AWS is not available)
# Free key: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MAX_RETRIES=5

# ------------------------------------------------------------
# Agent behaviour
# ------------------------------------------------------------
# tool_use (agents call tools in a loop) or single_shot (one JSON answer)
MANDATEIQ_AGENT_MODE=tool_use
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1500

# ------------------------------------------------------------
# Routing thresholds
# ------------------------------------------------------------
QUALITY_THRESHOLD=0.80
CONFIDENCE_THRESHOLD=0.70
TRUST_THRESHOLD=70
MAX_RETRIES=1
MAX_WORKFLOW_STEPS=25

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
# MANDATEIQ_DB=backend/data/mandateiq.db
# CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
